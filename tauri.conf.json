{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atmosphere",
  "version": "0.1.0",
  "identifier": "app.atmosphere.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Atmosphere",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "backgroundColor": "#0b0d14",
        "dragDropEnabled": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data: atmo: http://atmo.localhost; media-src 'self' atmo: http://atmo.localhost blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost atmo: http://atmo.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Save audio and video you have the rights to keep.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "licenseFile": "installer/RIGHTS.txt",
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "displayLanguageSelector": false
      },
      "wix": {
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}